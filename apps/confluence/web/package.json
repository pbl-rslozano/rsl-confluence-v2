{
  "name": "@rsl/confluence-web",
  "version": "2.7.0",
  "description": "rsL Confluence Terminal \u2014 web core (Next.js static export) shared by the Tauri, Capacitor and PWA shells.",
  "author": "rsLozano",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:static": "node scripts/build-html.mjs",
    "build:tauri": "node scripts/build-html.mjs --target=tauri",
    "build:capacitor": "node scripts/build-html.mjs --target=capacitor",
    "start": "next start",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test": "npm run test:engine && npm run test:fundtrend && npm run test:fundtrend-feed && npm run test:noise && npm run test:coinsph && npm run test:relay && npm run test:venues && npm run test:okx && npm run test:coinbase && npm run test:upbit && npm run test:links && npm run test:quotes && npm run test:fx && npm run test:chart && npm run test:measure && npm run test:measure23 && npm run test:paper && npm run test:fvg && npm run test:i18n && npm run test:theme && npm run test:update && npm run test:coffee && node --test src/lib/derivatives-context.test.mjs src/lib/order-flow.test.mjs && node --experimental-strip-types --no-warnings --test src/lib/progressive-scan.test.mjs",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "test:noise": "node scripts/run-engine-tests.mjs noise.test.mjs",
    "test:fvg": "node --experimental-strip-types --no-warnings src/lib/fvg.test.mjs",
    "test:fundtrend": "node scripts/run-engine-tests.mjs fund-trend.test.mjs",
    "test:fundtrend-feed": "node scripts/run-engine-tests.mjs fund-trend-feed.test.mjs",
    "test:i18n": "node --test scripts/catalog-status.test.mjs && node scripts/validate-catalogs.mjs",
    "test:theme": "node --experimental-strip-types --no-warnings --test src/lib/theme.test.mjs",
    "test:update": "node --experimental-strip-types --no-warnings --test src/lib/update-channel.test.mjs",
    "test:coffee": "node --experimental-strip-types --no-warnings --test src/rsl/coffee-kit.test.mjs",
    "calibrate": "node scripts/run-engine-tests.mjs null-calibration.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "replay": "node scripts/run-engine-tests.mjs replay.cli.mjs",
    "test:measure": "node scripts/run-engine-tests.mjs measure.test.mjs",
    "test:measure23": "node scripts/run-engine-tests.mjs measure23.test.mjs",
    "test:paper": "node scripts/run-engine-tests.mjs paper.test.mjs",
    "test:coinsph": "node scripts/run-engine-tests.mjs coinsph.test.mjs",
    "test:venues": "node scripts/run-engine-tests.mjs venue-ids.test.mjs",
    "test:relay": "node scripts/run-engine-tests.mjs native-relay.test.mjs",
    "test:quotes": "node scripts/run-engine-tests.mjs quotes.test.mjs",
    "test:chart": "node --experimental-strip-types --no-warnings --test src/lib/chart-view.test.mjs",
    "test:fx": "node scripts/run-engine-tests.mjs fx-rates.test.mjs",
    "test:okx": "node scripts/run-engine-tests.mjs okx.test.mjs",
    "test:coinbase": "node scripts/run-engine-tests.mjs coinbase.test.mjs",
    "test:upbit": "node scripts/run-engine-tests.mjs upbit.test.mjs",
    "test:links": "node scripts/run-engine-tests.mjs exchange-links.test.mjs"
  },
