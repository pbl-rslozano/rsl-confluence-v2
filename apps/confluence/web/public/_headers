# Netlify response headers for the hosted PWA + update channel (ADR-0012). Ignored by the native shells.
/updates/latest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/updates/*
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff

# v2.8 (WP28): the iPhone app-link file has no extension; Apple requires JSON. Exists only when the owner enables the link.
/.well-known/apple-app-site-association
  Content-Type: application/json

/sw.js
  Cache-Control: no-cache

/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
